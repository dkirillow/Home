{
  "name": "home",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "dev:api": "pnpm --filter api run dev",
    "dev:web": "pnpm --filter web run dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive --if-present run lint",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter api run prisma:migrate",
    "db:studio": "pnpm --filter api run prisma:studio"
  }
}
