# Скопируй в .env и заполни: cp .env.example .env

# Порт API (web работает на 3000)
PORT=3001

# Postgres из compose.yaml: пользователь postgres, порт 5433, база home (Prisma создаст её сама)
DATABASE_URL="postgresql://postgres:<password>@localhost:5433/home?schema=public"

# Секрет подписи JWT: любая длинная случайная строка
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Адрес фронта (для cookie и CORS)
WEB_ORIGIN=http://localhost:3000
