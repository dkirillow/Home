// Схема БД Home. Источник: методичка, раздел 5.
// Отличия от методички — только формат Prisma 7:
//   - генератор "prisma-client" с output в src (вместо "prisma-client-js");
//   - строка подключения не здесь, а в prisma7.config.ts (DATABASE_URL).
// Схему меняет только Лев, отдельным PR chore/db-<что>.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  MEMBER
}

enum AssetCategory {
  KITCHEN
  APPLIANCE
  ELECTRONICS
  FURNITURE
  OTHER
}

enum DocumentType {
  RECEIPT
  WARRANTY
  MANUAL
  CONTRACT
  OTHER
}

enum ExpenseCategory {
  GROCERIES
  UTILITIES
  INTERNET
  HOUSEHOLD_GOODS
  REPAIR
  APPLIANCES
  FURNITURE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
}

enum TaskCategory {
  PAYMENTS
  MAINTENANCE
  PURCHASES
  PROPERTY
  CLEANING
  OTHER
}

enum TaskStatus {
  TODO
  DONE
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  name          String
  createdAt     DateTime     @default(now())
  memberships   Membership[]
  assignedTasks Task[]       @relation("TaskAssignee")
}

model Household {
  id            String         @id @default(cuid())
  name          String         @default("Мой дом")
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  assets        Asset[]
  documents     Document[]
  expenses      Expense[]
  payments      Payment[]
  tasks         Task[]
  shoppingItems ShoppingItem[]
}

model Membership {
  id          String     @id @default(cuid())
  userId      String
  householdId String
  role        MemberRole @default(OWNER)
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
}

model Asset {
  id            String        @id @default(cuid())
  householdId   String
  createdById   String
  name          String
  category      AssetCategory @default(OTHER)
  manufacturer  String?
  model         String?
  price         Int? // рубли, без копеек
  purchaseDate  DateTime?
  warrantyUntil DateTime? // статус гарантии не храним, считаем getWarrantyStatus()
  serialNumber  String?
  notes         String?
  lastServiceAt DateTime?
  nextServiceAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  household     Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  documents     Document[]
  tasks         Task[]

  @@index([householdId, warrantyUntil])
  @@index([householdId, nextServiceAt])
}

model Document {
  id           String       @id @default(cuid())
  householdId  String
  createdById  String
  assetId      String?
  title        String
  type         DocumentType @default(OTHER)
  documentDate DateTime?
  fileKey      String       @unique // путь в хранилище: <householdId>/<uuid>.<ext>
  fileName     String // исходное имя файла
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime     @default(now())
  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([householdId, type])
  @@index([assetId])
}

model Expense {
  id          String          @id @default(cuid())
  householdId String
  createdById String
  title       String
  amount      Int // рубли
  category    ExpenseCategory
  date        DateTime
  comment     String?
  paymentId   String?         @unique // гарантия «один платёж → один расход»
  createdAt   DateTime        @default(now())
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  payment     Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([householdId, date])
}

model Payment {
  id          String          @id @default(cuid())
  householdId String
  createdById String
  title       String
  amount      Int // рубли
  category    ExpenseCategory @default(UTILITIES)
  dueDate     DateTime
  status      PaymentStatus   @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  expense     Expense?

  @@index([householdId, status, dueDate])
}

model Task {
  id          String       @id @default(cuid())
  householdId String
  createdById String
  assigneeId  String? // null = «Семья», свой id = «Я»
  assetId     String?
  title       String
  description String?
  category    TaskCategory @default(OTHER)
  dueDate     DateTime?
  status      TaskStatus   @default(TODO)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  asset       Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([householdId, status, dueDate])
}

model ShoppingItem {
  id          String    @id @default(cuid())
  householdId String
  createdById String
  name        String
  quantity    String? // «2 шт», «1 л» — строка, без единиц измерения
  isBought    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, isBought])
}
